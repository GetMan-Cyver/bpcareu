---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Legality from '../components/Legality.astro';
import PricingTable from '../components/PricingTable.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import ProductModal from '../components/ProductModal.astro';
import DoseCalculator from '../components/DoseCalculator.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import Toast from '../components/Toast.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Legality />
    <PricingTable />
    <ProductCatalog />
    <ProductModal />
    <DoseCalculator />
    <Faq />
  </main>
  <Footer />
  <CartDrawer />
  <CheckoutModal />
  <Toast />

  <script src="../scripts/app.ts"></script>
</Layout>
