---
---

<!-- MODAL DETAIL PRODUK -->
<div
  id="productDetailModal"
  class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detailTitle"
>
  <div class="bg-white rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[92vh] animate-in fade-in zoom-in-95 duration-150">
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-slate-200 bg-gradient-to-r from-bpRed-800 to-red-700 text-white flex justify-between items-center shrink-0">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <h3 class="font-extrabold text-sm sm:text-base leading-tight">Detail Produk BP Group</h3>
      </div>
      <button
        id="closeDetailBtn"
        type="button"
        class="w-8 h-8 rounded-full bg-black/20 hover:bg-black/40 flex items-center justify-center text-white transition-colors cursor-pointer"
        title="Tutup Modal (Esc)"
        aria-label="Tutup"
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-6">
      <div class="grid sm:grid-cols-12 gap-6 items-start">
        <!-- Gambar Produk Real -->
        <div class="sm:col-span-5 flex flex-col items-center">
          <div class="w-full aspect-square rounded-2xl bg-slate-100 border border-slate-200 p-4 flex items-center justify-center overflow-hidden relative group">
            <img id="detailImg" src="" alt="Produk BP" class="w-full h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-300" />
            <span id="detailBadge" class="absolute top-2.5 left-2.5 text-[10px] font-extrabold bg-bpRed-700 text-white px-2 py-0.5 rounded-md shadow-xs">BP Group</span>
          </div>
          <div class="mt-3 flex items-center gap-1.5 text-emerald-600 text-xs font-bold">
            <i class="fa-solid fa-shield-halved"></i>
            <span>100% Original Bersegel</span>
          </div>
        </div>

        <!-- Rincian Produk -->
        <div class="sm:col-span-7 space-y-3">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span id="detailVolume" class="text-[10px] font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded"></span>
              <span id="detailCategory" class="text-[10px] font-bold bg-red-100 text-red-800 px-2 py-0.5 rounded uppercase"></span>
            </div>
            <h2 id="detailTitle" class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight"></h2>
            <p id="detailTagline" class="text-xs font-semibold text-bpRed-700 mt-0.5"></p>
          </div>

          <!-- Harga & Status -->
          <div class="p-3 bg-red-50/60 rounded-2xl border border-red-100 flex items-baseline justify-between">
            <div>
              <span class="text-[10px] text-slate-400 block font-semibold">Harga Resmi Satuan</span>
              <span id="detailPrice" class="text-xl font-extrabold text-bpRed-800"></span>
            </div>
            <span class="text-xs font-bold text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-full flex items-center gap-1">
              <i class="fa-solid fa-circle-check text-[10px]"></i> Ready Stock
            </span>
          </div>

          <!-- Legalitas BPOM RI -->
          <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-file-shield text-blue-600"></i>
              <span class="font-bold text-slate-700">Nomor Registrasi:</span>
              <span id="detailBpom" class="font-mono text-bpRed-700 font-bold"></span>
            </div>
            <a
              href="https://cekbpom.pom.go.id"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] text-blue-600 hover:underline font-semibold flex items-center gap-1"
            >
              Cek BPOM <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
            </a>
          </div>

          <!-- Deskripsi Singkat -->
          <p id="detailDesc" class="text-xs text-slate-600 leading-relaxed"></p>
        </div>
      </div>

      <!-- Khasiat & Manfaat Utama -->
      <div class="space-y-2 border-t border-slate-100 pt-4">
        <h4 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-emerald-600"></i>
          Khasiat & Manfaat Utama:
        </h4>
        <ul id="detailBenefits" class="grid sm:grid-cols-2 gap-2 text-xs text-slate-600">
          <!-- Injected dynamically -->
        </ul>
      </div>

      <!-- Aturan Pakai & Komposisi -->
      <div class="grid sm:grid-cols-2 gap-3 pt-2">
        <div class="p-3.5 rounded-2xl bg-amber-50/70 border border-amber-200/80 text-xs space-y-1">
          <p class="font-extrabold text-amber-900 flex items-center gap-1.5">
            <i class="fa-solid fa-droplet text-amber-600"></i> Aturan Pakai:
          </p>
          <p id="detailUsage" class="text-slate-700 leading-relaxed"></p>
        </div>
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-1">
          <p class="font-extrabold text-slate-800 flex items-center gap-1.5">
            <i class="fa-solid fa-flask text-bpRed-700"></i> Komposisi / Formula:
          </p>
          <p id="detailIngredients" class="text-slate-600 leading-relaxed"></p>
        </div>
      </div>
    </div>

    <!-- Modal Footer (Actions) -->
    <div class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
      <!-- Qty selector -->
      <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-start">
        <span class="text-xs font-bold text-slate-600">Kuantitas:</span>
        <div class="flex items-center border border-slate-300 rounded-xl bg-white overflow-hidden">
          <button id="qtyDecBtn" type="button" class="w-8 h-8 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100 cursor-pointer">-</button>
          <input
            type="number"
            id="detailQtyInput"
            value="1"
            min="1"
            max="99"
            class="w-10 text-center text-xs font-bold text-slate-800 focus:outline-none"
            aria-label="Jumlah kuantitas"
          />
          <button id="qtyIncBtn" type="button" class="w-8 h-8 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100 cursor-pointer">+</button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button
          id="addDetailToCartBtn"
          type="button"
          class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-bpRed-700 text-bpRed-700 hover:bg-red-50 text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <i class="fa-solid fa-cart-plus"></i> Tambah Keranjang
        </button>
        <button
          id="buyDetailWaBtn"
          type="button"
          class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <i class="fa-brands fa-whatsapp text-sm"></i> Beli Sekarang
        </button>
      </div>
    </div>
  </div>
</div>
