---
---

<section class="relative overflow-hidden bg-gradient-to-b from-red-50/70 via-white to-slate-50 pt-10 pb-16 lg:pt-16 lg:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <!-- Hero Copy -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-100/90 border border-red-200 text-red-900 text-xs font-bold">
          <i class="fa-solid fa-shield-halved text-bpRed-600"></i>
          <span>Distributor Resmi BP Group Indonesia</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Jaga Kesehatan Keluarga dengan <span class="text-bpRed-700 underline decoration-amber-400 decoration-wavy decoration-2">BP Group</span> Berkualitas Dunia
        </h1>

        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Pusat resmi produk kesehatan premium: <strong>British Propolis</strong>, pemanis alami <strong>Steffi Stevia</strong>, kesehatan mata <strong>Brassic Eye</strong>, sendi <strong>Brassic Pro</strong>, dan minyak ikan salmon <strong>BP Norway</strong>.
        </p>

        <!-- Highlights -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-left">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
            <i class="fa-solid fa-medal text-amber-500 text-lg"></i>
            <span class="text-xs font-bold text-slate-700">Formula Premium UK</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
            <i class="fa-solid fa-cubes-stacked text-bpRed-600 text-lg"></i>
            <span class="text-xs font-bold text-slate-700">Hemat Paket Grosir</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs col-span-2 sm:col-span-1">
            <i class="fa-solid fa-clipboard-check text-emerald-600 text-lg"></i>
            <span class="text-xs font-bold text-slate-700">BPOM & Halal MUI</span>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-4 justify-center lg:justify-start">
          <a
            href="#paket-harga"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-bold text-base shadow-lg shadow-red-700/25 transition-all text-center flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-tags"></i>
            Lihat Daftar Paket Harga
          </a>
          <a
            href="#katalog"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-bold text-base border border-slate-300 transition-all text-center flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-cubes text-bpRed-700"></i>
            Katalog Produk Satuan
          </a>
        </div>

        <div class="pt-2 flex items-center justify-center lg:justify-start gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-truck-fast text-emeraldBrand-600"></i> Pengiriman ke Seluruh Indonesia</span>
          <span>•</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-lock text-bpRed-600"></i> Transaksi Terverifikasi CS</span>
        </div>
      </div>

      <!-- Hero Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-sm sm:max-w-md bg-gradient-to-b from-white to-red-50/40 p-6 rounded-3xl border border-red-100 shadow-xl shadow-red-900/5">
          <div class="absolute -top-4 -right-4 bg-red-900 text-white p-3 rounded-2xl shadow-lg flex items-center gap-2.5">
            <i class="fa-solid fa-star text-amber-400 text-xl"></i>
            <div>
              <p class="text-[10px] font-medium text-red-200 uppercase leading-none">Standar Internasional</p>
              <p class="text-xs font-extrabold">Original BP Group</p>
            </div>
          </div>

          <!-- Visual Showcase Badge with SVG Products -->
          <div class="py-8 flex flex-col items-center justify-center space-y-4">
            <div class="grid grid-cols-3 gap-2.5 w-full">
              <!-- Propolis card preview -->
              <div class="p-3 bg-red-50 rounded-2xl border border-red-200 text-center flex flex-col items-center">
                <div class="w-10 h-10 rounded-xl bg-red-800 text-amber-300 flex items-center justify-center text-lg mb-1.5 shadow-sm">
                  <i class="fa-solid fa-shield-virus"></i>
                </div>
                <span class="text-[11px] font-bold text-slate-900">British Propolis</span>
                <span class="text-[9px] text-red-700 font-semibold">Reguler / Kids</span>
              </div>

              <!-- Steffi Stevia preview -->
              <div class="p-3 bg-emerald-50 rounded-2xl border border-emerald-200 text-center flex flex-col items-center">
                <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center text-lg mb-1.5 shadow-sm">
                  <i class="fa-solid fa-leaf"></i>
                </div>
                <span class="text-[11px] font-bold text-slate-900">Steffi Stevia</span>
                <span class="text-[9px] text-emerald-700 font-semibold">0 Kalori Alami</span>
              </div>

              <!-- Brassic Eye preview -->
              <div class="p-3 bg-rose-50 rounded-2xl border border-rose-200 text-center flex flex-col items-center">
                <div class="w-10 h-10 rounded-xl bg-rose-700 text-white flex items-center justify-center text-lg mb-1.5 shadow-sm">
                  <i class="fa-solid fa-eye"></i>
                </div>
                <span class="text-[11px] font-bold text-slate-900">Brassic Eye</span>
                <span class="text-[9px] text-rose-700 font-semibold">Nutrisi Mata</span>
              </div>

              <!-- Brassic Pro preview -->
              <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200 text-center flex flex-col items-center">
                <div class="w-10 h-10 rounded-xl bg-amber-600 text-white flex items-center justify-center text-lg mb-1.5 shadow-sm">
                  <i class="fa-solid fa-bone"></i>
                </div>
                <span class="text-[11px] font-bold text-slate-900">Brassic Pro</span>
                <span class="text-[9px] text-amber-700 font-semibold">Sendi & Otot</span>
              </div>

              <!-- BP Norway preview -->
              <div class="p-3 bg-sky-50 rounded-2xl border border-sky-200 text-center flex flex-col items-center col-span-2">
                <div class="w-10 h-10 rounded-xl bg-sky-700 text-white flex items-center justify-center text-lg mb-1.5 shadow-sm">
                  <i class="fa-solid fa-fish"></i>
                </div>
                <span class="text-[11px] font-bold text-slate-900">BP Norway Salmon Fish Oil</span>
                <span class="text-[9px] text-sky-700 font-semibold">Omega 3, DHA & EPA Alami</span>
              </div>
            </div>

            <!-- Price highlights callout -->
            <div class="w-full bg-white p-3 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-bold text-slate-800">Mulai Rp 175.000 / pcs</span>
              </div>
              <span class="text-[11px] font-extrabold text-bpRed-700 bg-red-50 px-2 py-0.5 rounded">Khusus Paket Kemitraan</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
