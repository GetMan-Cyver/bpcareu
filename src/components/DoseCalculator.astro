---
---

<section id="kalkulator" class="py-16 bg-slate-50 border-t border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-red-950 via-bpRed-900 to-slate-900 text-white rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <div class="relative z-10 space-y-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-amber-400 text-red-950 text-xs font-extrabold uppercase tracking-wider mb-2">
            Panduan Pemakaian Cerdas
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Kalkulator Dosis British Propolis</h2>
          <p class="text-red-200/90 text-xs sm:text-sm mt-1">
            Rumus standar pemakaian BP: <strong>1 tetes per 10 kg berat badan</strong>. Sesuaikan anjuran kebutuhan harian Anda:
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-4 pt-2">
          <div class="space-y-1.5">
            <label for="calcWeight" class="text-xs font-semibold text-red-100">Berat Badan (kg)</label>
            <input
              type="number"
              id="calcWeight"
              value="60"
              min="10"
              max="150"
              class="w-full bg-red-900/60 border border-red-700/80 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-amber-400"
            />
          </div>

          <div class="space-y-1.5">
            <label for="calcAgeCategory" class="text-xs font-semibold text-red-100">Kategori Usia</label>
            <select
              id="calcAgeCategory"
              class="w-full bg-red-900/60 border border-red-700/80 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-amber-400"
            >
              <option value="adult" class="text-slate-800">Dewasa (&gt;12 tahun)</option>
              <option value="child" class="text-slate-800">Anak-anak (1-12 tahun)</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="calcPurpose" class="text-xs font-semibold text-red-100">Tujuan Konsumsi</label>
            <select
              id="calcPurpose"
              class="w-full bg-red-900/60 border border-red-700/80 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-amber-400"
            >
              <option value="stamina" class="text-slate-800">Jaga Imunitas / Stamina</option>
              <option value="recovery" class="text-slate-800">Pemulihan Sakit / Flu / Batuk</option>
              <option value="chronic" class="text-slate-800">Gula Darah / Kolesterol / Asam Urat</option>
            </select>
          </div>
        </div>

        <button
          id="btnCalculateDose"
          type="button"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-red-950 font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <i class="fa-solid fa-calculator"></i>
          Hitung Dosis & Waktu Terbaik Minum
        </button>

        <div id="calcResultBox" class="p-5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-white space-y-2">
          <div class="flex items-center gap-2 text-amber-300 text-sm font-bold">
            <i class="fa-solid fa-circle-check"></i>
            <span>Hasil Anjuran Dosis BPCareU:</span>
          </div>
          <p id="calcDoseText" class="text-base sm:text-lg font-bold text-white">
            6 Tetes, diminum 2 kali sehari (Pagi sebelum sarapan & Malam sebelum tidur).
          </p>
          <p id="calcProductSuggestion" class="text-xs text-red-200">
            Rekomendasi Utama: <strong>British Propolis Regular (Merah)</strong>. Larutkan dalam 1/3 gelas air hangat kuku.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
