---
import { PACKAGES } from '../data/packages';
import { formatRupiah } from '../utils/formatters';
---

<section id="paket-harga" class="py-16 bg-gradient-to-b from-slate-50 to-red-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-extrabold uppercase tracking-wider">
        DAFTAR HARGA RESMI BP GROUP
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Pilihan Paket Belanja Hemat & Kemitraan
      </h2>
      <p class="text-slate-600 text-xs sm:text-sm">
        Harga berlaku untuk seluruh varian: British Propolis (Reg/Kids), Steffi Stevia, Brassic Eye, Brassic Pro, dan BP Norway.
      </p>
    </div>

    <!-- Pricing Table Container -->
    <div class="bg-white rounded-3xl shadow-xl border border-red-100 overflow-hidden max-w-5xl mx-auto">
      <!-- Table Header Bar -->
      <div class="bg-gradient-to-r from-bpRed-800 via-red-600 to-bpRed-800 text-white p-4 sm:p-5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center font-black text-sm italic">BP</div>
          <div>
            <h3 class="font-extrabold text-base sm:text-lg">DAFTAR HARGA BP GROUP</h3>
            <p class="text-[11px] text-red-100">Bisa campur produk sesuai kebutuhan paket Anda</p>
          </div>
        </div>
        <span class="text-[10px] font-bold bg-amber-400 text-red-950 px-2.5 py-1 rounded-full">Resmi 2026</span>
      </div>

      <!-- Table Responsive Body -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-red-700 text-white text-xs uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6 font-extrabold">Nama Paket</th>
              <th class="py-3.5 px-4 sm:px-6 font-extrabold text-center">Harga/PCS</th>
              <th class="py-3.5 px-4 sm:px-6 font-extrabold text-right">Total Harga</th>
              <th class="py-3.5 px-4 sm:px-6 font-extrabold text-center">Aksi Cepat</th>
            </tr>
          </thead>
          <tbody id="packageTableBody" class="divide-y divide-slate-100 text-xs sm:text-sm">
            {PACKAGES.map((pkg, idx) => (
              <tr class={`hover:bg-red-50/40 transition-colors ${idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}`}>
                <td class="py-3.5 px-4 sm:px-6">
                  <div class="font-extrabold text-slate-900 text-sm sm:text-base">{pkg.name}</div>
                  <span class="inline-block mt-0.5 text-[10px] font-bold text-red-700 bg-red-100 px-2 py-0.5 rounded-full">
                    {pkg.badge}
                  </span>
                </td>
                <td class="py-3.5 px-4 sm:px-6 text-center font-bold text-slate-700">
                  {pkg.qty} PCS <span class="text-slate-400 font-normal">@Rp {formatRupiah(pkg.unitPrice)}</span>
                </td>
                <td class="py-3.5 px-4 sm:px-6 text-right font-extrabold text-bpRed-800 text-sm sm:text-base">
                  Rp {formatRupiah(pkg.totalPrice)}
                </td>
                <td class="py-3.5 px-4 sm:px-6 text-center">
                  <button
                    type="button"
                    data-package-id={pkg.id}
                    class="btn-add-package px-3.5 py-1.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-bold text-xs shadow-xs hover:shadow transition-all flex items-center justify-center gap-1.5 mx-auto cursor-pointer"
                  >
                    <i class="fa-solid fa-cart-plus"></i> Beli Paket
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Footer note in table -->
      <div class="p-3 bg-red-50/80 border-t border-red-100 text-[11px] text-slate-500 text-right pr-6 italic">
        *) Harga resmi terstandar BP Group per 1 September 2026. Bebas pilih varian produk dalam satu paket.
      </div>
    </div>
  </div>
</section>
